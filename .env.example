# Conexão do Postgres do Supabase. Em produção use a do pooler (modo transação, porta 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# URL do projeto e a chave secreta (service role / sb_secret_...). Só no servidor, nunca no navegador.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Assina o cookie de sessão. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Código de instalação: libera criar a conta do dono no primeiro acesso. Guarde fora do sistema.
# Gere com o mesmo comando acima (12+ caracteres).
CODIGO_INSTALACAO=
# Só para testes locais com o build de produção e o WhatsApp simulado: mostra o código de entrada na tela.
# NUNCA ligue em produção (qualquer um entraria só sabendo o número de alguém).
# CODIGO_NA_TELA=1

# IA (Claude, da Anthropic): lê as respostas dos fornecedores e compara as propostas. Sem ela, os preços são preenchidos à mão.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta). Sem WHATSAPP_TOKEN e WHATSAPP_PHONE_ID o sistema fica em modo simulado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Segredo do app na Meta: confere a assinatura de cada mensagem que chega no webhook.
WHATSAPP_APP_SECRET=
# Texto que você inventa e repete na Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Senha da rotina diária de lembretes (a Vercel envia sozinha; gere um texto aleatório).
CRON_SECRET=
